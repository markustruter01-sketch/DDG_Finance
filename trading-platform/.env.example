# ---- Data Sources ----
FRED_API_KEY=your_fred_key_here
NEWS_API_KEY=your_newsapi_key_here

# ---- Alpaca (Paper Trading) ----
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- LLM ----
ANTHROPIC_API_KEY=your_claude_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ---- Trading Constraints ----
CONVICTION_THRESHOLD=0.75
KILL_SWITCH_DRAWDOWN_PCT=0.05
# Required by the API middleware; store the real value in Replit Secrets.
TRADING_API_SECRET=generate-a-long-random-value
# Required to reset a tripped kill switch; store the real value in Replit Secrets.
KILL_SWITCH_RESET_CONFIRMATION=generate-a-separate-random-value
TOTAL_CAPITAL_SLOTS=10
CASH_EQUIVALENT_TICKER=SGOV

# ---- Throttling ----
MAX_RETRIES=5
BACKOFF_MIN_WAIT=1.0
BACKOFF_MAX_WAIT=60.0

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

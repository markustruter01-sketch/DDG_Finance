# The VITE_ value is compiled into the browser bundle and is visible to anyone
# who can inspect the dashboard. It is only a shared-operator convenience for
# development, not a substitute for user authentication.
VITE_TRADING_API_SECRET=copy-the-development-api-secret-here

# Optional API path override; the default is the routed trading API.
VITE_API_BASE_URL=/trading-api
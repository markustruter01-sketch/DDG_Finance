modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/dashboard: poseidon-bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/dashboard: kraken-current-bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/dashboard: apex-predator-bot"

[[workflows.workflow]]
name = "artifacts/dashboard: poseidon-bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 poseidon/main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/dashboard: kraken-current-bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 kraken-current/main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/dashboard: apex-predator-bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && BOT_ID=apex-predator python3 kraken-bot/main.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

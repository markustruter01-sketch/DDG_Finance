modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[deployment]
router = "application"
deploymentTarget = "gce"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt", "postgresql_17"]

[userenv]

[userenv.shared]
PER_BOT_VAULT_ENABLED = "true"
# Kill switch: ALERT ONLY (Markus 14 Nov 2026). Paper trading; every automatic trip so far
# froze all four bots for a data problem (7 Nov Forex records, 9 Nov stop re-arm, 13 Nov
# OANDA answering 401/504 on and off). It still checks every 5 minutes and records each
# "would trip" as a warning; it never pauses bots. Re-design before any real money.
KILL_SWITCH_ARMED = "false"

[userenv.development]
DDG_FLEET_PUSH_URL = "https://ddg-control.replit.app/api/inbound/fleet"
FLEET_PUSH_ENABLED = "false"
# The workspace's DATABASE_URL is the LIVE database. Every workspace database
# session is read-only so a restart or git pull can never run startup SQL on
# live data (10 Nov 2026). Never add this to [userenv.production] or shared.
# A deliberate one-off write from the workspace: prefix the command with PGOPTIONS=
PGOPTIONS = "-c default_transaction_read_only=on"

[userenv.production]
DDG_FLEET_PUSH_URL = "https://ddg-control.replit.app/api/inbound/fleet"
FLEET_PUSH_ENABLED = "true"

[[ports]]
localPort = 23183
externalPort = 80
